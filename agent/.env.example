# Sprint 2 — Agent Layer
# Copy this file to .env and fill in your values.
# Never commit the real .env file.

# GitHub Personal Access Token with repo scope (to post PR comments)
GITHUB_TOKEN=your_github_token_here

# The PR number on https://github.com/YarKoA/IBM-Bob-2.0-Hackathon-ZeroShot
# where the alert comment should be posted
GITHUB_PR_NUMBER=1

# GitHub repo owner and name (defaults match the hackathon repo)
GITHUB_OWNER=YarKoA
GITHUB_REPO=IBM-Bob-2.0-Hackathon-ZeroShot
